# Hostkeep collector (writes to the MariaDB database "hostkeep").
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""
* * * * *   root /usr/bin/php /var/www/hostkeep/bin/collect.php minute 2>>/var/log/hostkeep/collect.log
*/5 * * * * root /usr/bin/php /var/www/hostkeep/bin/collect.php 5min 2>>/var/log/hostkeep/collect.log
17 * * * *  root /usr/bin/php /var/www/hostkeep/bin/collect.php hourly 2>>/var/log/hostkeep/collect.log
42 3 * * *  root /usr/bin/php /var/www/hostkeep/bin/collect.php purge 2>>/var/log/hostkeep/collect.log
10 3 * * *  root /usr/bin/php /var/www/hostkeep/bin/collect.php backup >/dev/null 2>>/var/log/hostkeep/collect.log
20 4 * * *  root /usr/bin/php /var/www/hostkeep/bin/collect.php scan >/dev/null 2>>/var/log/hostkeep/collect.log
