#!/bin/bash
# Root helper of the Hostkeep. Only user "hostkeep" may run it, through sudo
# (/etc/sudoers.d/hostkeep). It runs a fixed allow-list of actions and validates every
# argument itself. There is no generic command execution.
#
#   hostkeep-action job <verb> [args...]   validate, then run in the background (systemd-run), print the job id
#   hostkeep-action log <key> [lines]      print the tail of an allowed log
#
# Never touches: sshd, network, firewall, reboot, certificate deletion.
set -uo pipefail
umask 027
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C HOME=/root PM2_HOME=/root/.pm2

JOBS=/var/lib/hostkeep/jobs
APP=/var/www/hostkeep
BACKUPS=/var/backups/hostkeep
SELF=/usr/local/sbin/hostkeep-action

# Settings from the install's .env (KEY=value). Read with grep, never sourced: nothing is executed.
env_get() {
  local v
  v=$(grep -m1 -E "^[[:space:]]*$1[[:space:]]*=" "$APP/.env" 2>/dev/null | cut -d= -f2- | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')
  v=${v#[\"\']}; v=${v%[\"\']}
  printf '%s' "${v:-${2:-}}"
}
PHPV=$(env_get HOSTKEEP_PHP_VERSION "$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null)")
detect_services() {
  local s out=()
  for s in apache2 nginx "php$PHPV-fpm" mariadb mysql fail2ban cron postfix; do
    [[ $s == mysql ]] && in_list mariadb "${out[@]}" && continue   # alias of mariadb on Debian
    systemctl cat "$s.service" >/dev/null 2>&1 && out+=("$s")
  done
  echo "${out[*]}"
}

die() { echo "Refusé : $*" >&2; exit 2; }
in_list() { local x=$1; shift; local i; for i in "$@"; do [[ $i == "$x" ]] && return 0; done; return 1; }
pm2_names() { pm2 jlist 2>/dev/null | python3 -c 'import json,sys; [print(p["name"]) for p in json.load(sys.stdin)]' 2>/dev/null; }
jails() { fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr ',' '\n' | tr -d ' \t'; }
valid_ip() { python3 -I -c 'import ipaddress,sys; ipaddress.ip_address(sys.argv[1])' "$1" 2>/dev/null; }
services() { local s; s=$(env_get HOSTKEEP_SERVICES); if [[ -n $s ]]; then echo "$s"; else detect_services; fi; }

validate() {
  local verb=${1:-}; shift || true
  case $verb in
    service)
      [[ $# -eq 2 ]] || die "arguments"
      in_list "$1" restart reload || die "action de service inconnue"
      in_list "$2" $(services) || die "service non autorisé"
      if [[ $1 == reload && $2 == cron ]]; then die "reload non supporté pour cron"; fi ;;
    pm2-restart)
      [[ $# -eq 1 && $1 =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "nom d'appli"
      in_list "$1" $(pm2_names) || die "appli PM2 inconnue" ;;
    site)
      [[ $# -eq 2 ]] || die "arguments"
      in_list "$1" enable disable || die "action de site inconnue"
      [[ $2 =~ ^[A-Za-z0-9._-]{1,100}$ ]] || die "nom de vhost"
      [[ -f /etc/apache2/sites-available/$2.conf ]] || die "vhost inconnu"
      [[ $2 == hostkeep* ]] && die "le vhost du tableau de bord est protégé"
      return 0 ;;
    certbot)
      [[ $# -eq 1 ]] && in_list "$1" dry-run renew || die "action certbot" ;;
    apt-clean|journal-vacuum|collect-now|backup-now|security-scan|apt-update|apt-upgrade)
      [[ $# -eq 0 ]] || die "arguments" ;;
    backup-restore)
      [[ $# -eq 2 && $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && $2 =~ ^[A-Za-z0-9_-]{1,64}$ ]] || die "arguments"
      [[ $2 == mysql ]] && die "la base système mysql ne se restaure pas d'ici"
      [[ -f $BACKUPS/$1/$2.sql.gz ]] || die "sauvegarde introuvable"
      mysql -N -e "SHOW DATABASES" | grep -qx -- "$2" || die "base inconnue" ;;
    f2b-unban)
      [[ $# -eq 2 && $1 =~ ^[a-z0-9_-]{1,40}$ ]] || die "arguments"
      in_list "$1" $(jails) || die "jail inconnue"
      valid_ip "$2" || die "adresse IP invalide" ;;
    *) die "action inconnue" ;;
  esac
}

configtest() { echo "# apache2ctl configtest"; apache2ctl configtest 2>&1 | grep -v AH00558; return "${PIPESTATUS[0]}"; }

run() {
  local verb=$1; shift
  case $verb in
    service)
      if [[ $2 == apache2 ]]; then configtest || { echo "configtest en échec : rien n'a été fait."; return 1; }; fi
      if [[ $2 == nginx ]]; then echo "# nginx -t"; nginx -t 2>&1 || { echo "nginx -t en échec : rien n'a été fait."; return 1; }; fi
      echo "# systemctl $1 $2"
      systemctl "$1" "$2" || return 1
      sleep 1; systemctl --no-pager --lines=0 status "$2" | head -6 ;;
    pm2-restart)
      echo "# pm2 restart $1"; pm2 restart "$1" && pm2 list ;;
    site)
      if [[ $1 == enable ]]; then
        a2ensite "$2" || return 1
        if ! configtest; then echo "configtest en échec : retour arrière."; a2dissite "$2"; return 1; fi
      else
        a2dissite "$2" || return 1
        if ! configtest; then echo "configtest en échec : retour arrière."; a2ensite "$2"; return 1; fi
      fi
      echo "# systemctl reload apache2"; systemctl reload apache2 && echo "Apache rechargé." ;;
    certbot)
      if [[ $1 == dry-run ]]; then certbot renew --dry-run --no-random-sleep-on-renew; else certbot renew --no-random-sleep-on-renew; fi ;;
    apt-clean)
      echo "Avant : $(du -sh /var/cache/apt | cut -f1)"; apt-get clean && echo "Après : $(du -sh /var/cache/apt | cut -f1)" ;;
    journal-vacuum)
      journalctl --vacuum-size=50M; journalctl --disk-usage ;;
    f2b-unban)
      fail2ban-client set "$1" unbanip "$2" ;;
    collect-now)
      php "$APP/bin/collect.php" all && echo "Collecte terminée." ;;
    backup-now)
      php "$APP/bin/collect.php" backup && echo "Sauvegarde terminée." ;;
    backup-restore)
      mkdir -p "$BACKUPS/pre-restore" && chgrp hostkeep "$BACKUPS/pre-restore" && chmod 750 "$BACKUPS/pre-restore"
      pre="$BACKUPS/pre-restore/$(date +%Y%m%d-%H%M%S)-$2.sql.gz"
      echo "# Copie de sécurité de l'état actuel de $2 -> $pre"
      bash -c 'set -o pipefail; mysqldump --single-transaction --quick --routines --triggers --events "$1" | gzip -6 > "$2"' _ "$2" "$pre" || { echo "Copie de sécurité impossible : restauration annulée."; rm -f "$pre"; return 1; }
      chgrp hostkeep "$pre"; chmod 640 "$pre"
      echo "# Restauration de $2 depuis la sauvegarde du $1"
      gunzip -c "$BACKUPS/$1/$2.sql.gz" | mysql "$2" || return 1
      php "$APP/bin/collect.php" backup-list >/dev/null 2>&1; echo "Restauration terminée." ;;
    security-scan)
      php "$APP/bin/collect.php" scan ;;
    apt-update)
      apt-get update && php "$APP/bin/collect.php" updates && apt list --upgradable 2>/dev/null ;;
    apt-upgrade)
      export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=l
      apt-get update || return 1
      apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold upgrade || return 1
      php "$APP/bin/collect.php" updates
      if [[ -f /run/reboot-required ]]; then echo "Un redémarrage du serveur est conseillé (à faire toi-même en SSH)."; fi
      echo "Mises à jour installées." ;;
  esac
}

# Read-only file access, limited to these trees (after resolving symlinks and "..").
# HOSTKEEP_FILE_ROOTS in .env; only the folders that exist are kept.
FS_ROOTS=""
for r in $(env_get HOSTKEEP_FILE_ROOTS "/var/www /etc/apache2 /etc/nginx /etc/php /etc/mysql /etc/cron.d /etc/fail2ban /etc/letsencrypt/renewal /etc/logrotate.d /var/log"); do
  [[ $r == /* && -d $r ]] && FS_ROOTS+="$(realpath -e -- "$r") "
done
fs_path() {
  local p r
  [[ ${1:-} == /* && ${#1} -lt 4096 ]] || { echo "Refusé : chemin" >&2; return 2; }
  p=$(realpath -e -- "$1" 2>/dev/null) || { echo "Refusé : chemin introuvable" >&2; return 2; }
  for r in $FS_ROOTS; do
    if [[ $p == "$r" || $p == "$r/"* ]]; then echo "$p"; return 0; fi
  done
  echo "Refusé : hors des dossiers autorisés" >&2; return 2
}

cmd=${1:-}; shift || true
case $cmd in
  job)
    validate "$@"
    id="$(date +%s)-$$"
    log="$JOBS/$id.log"
    : > "$log" && chgrp hostkeep "$log" && chmod 640 "$log" || die "impossible de créer le journal de la tâche"
    # Transient unit: the job lives outside PHP-FPM's cgroup, so restarting php-fpm does not kill it.
    systemd-run --quiet --collect --unit="hostkeep-job-$id" -p StandardOutput="append:$log" -p StandardError=inherit \
      "$SELF" _run "$id" "$@" >/dev/null || die "systemd-run a échoué"
    echo "$id" ;;
  _run)
    id=${1:-}; shift || true
    [[ $id =~ ^[0-9]+-[0-9]+$ ]] || die "id"
    validate "$@"
    echo "### $(date '+%F %T') — $*"
    run "$@"; rc=$?
    echo "### Terminé (code $rc)"
    echo "$rc" > "$JOBS/$id.rc.tmp" && chgrp hostkeep "$JOBS/$id.rc.tmp" && chmod 640 "$JOBS/$id.rc.tmp" && mv "$JOBS/$id.rc.tmp" "$JOBS/$id.rc" ;;
  log)
    key=${1:-}; n=${2:-200}
    [[ $n =~ ^[0-9]{1,4}$ ]] || die "nombre de lignes"
    case $key in
      journal-errors) journalctl -p err -n "$n" --no-pager -o short-iso ;;
      fail2ban) tail -n "$n" /var/log/fail2ban.log ;;
      hostkeep-auth) tail -n "$n" /var/log/hostkeep/auth.log 2>/dev/null || true ;;
      apache:*)
        f=${key#apache:}
        [[ $f =~ ^[A-Za-z0-9._-]+\.log$ && -f /var/log/apache2/$f && ! -L /var/log/apache2/$f ]] || die "journal inconnu"
        tail -n "$n" -- "/var/log/apache2/$f" ;;
      pm2:*)
        a=${key#pm2:}
        [[ $a =~ ^[A-Za-z0-9._-]{1,64}$ ]] && in_list "$a" $(pm2_names) || die "appli PM2 inconnue"
        pm2 logs "$a" --lines "$n" --nostream --raw 2>&1 ;;
      *) die "journal inconnu" ;;
    esac ;;
  fs-roots)
    printf '%s\n' $FS_ROOTS ;;
  fs-list)
    p=$(fs_path "${1:-}") || exit 2
    [[ -d $p ]] || die "pas un dossier"
    python3 -I - "$p" <<'PY'
import grp, json, os, pwd, stat, sys
path = sys.argv[1]
def name(fn, i):
    try: return fn(i)[0]
    except KeyError: return str(i)
out = []
with os.scandir(path) as it:
    for e in it:
        try: st = e.stat(follow_symlinks=False)
        except OSError: continue
        kind = 'link' if stat.S_ISLNK(st.st_mode) else 'dir' if stat.S_ISDIR(st.st_mode) else 'file'
        out.append({'name': e.name, 'type': kind, 'size': st.st_size, 'mtime': int(st.st_mtime),
                    'mode': stat.filemode(st.st_mode), 'owner': name(pwd.getpwuid, st.st_uid), 'group': name(grp.getgrgid, st.st_gid)})
out.sort(key=lambda x: (x['type'] != 'dir', x['name'].lower()))
print(json.dumps({'path': path, 'entries': out[:3000], 'total': len(out)}))
PY
    ;;
  fs-read)
    p=$(fs_path "${1:-}") || exit 2
    max=${2:-524288}
    [[ -f $p ]] || die "pas un fichier"
    [[ $max =~ ^[0-9]{1,9}$ ]] && (( max <= 52428800 )) || die "taille"
    [[ $(basename -- "$p") =~ (privkey|\.key$|^id_(rsa|ed25519|ecdsa)) ]] && die "clé privée : lecture refusée"
    head -c "$max" -- "$p" ;;
  *) die "commande inconnue" ;;
esac
