#!/bin/bash
# Root helper of the Hostkeep. Only user "hostkeep" may run it, through sudo
# (/etc/sudoers.d/hostkeep). It runs a fixed allow-list of actions and validates every
# argument itself. There is no generic command execution.
#
#   hostkeep-action job <verb> [args...]   validate, then run in the background (systemd-run), print the job id
#   hostkeep-action log <key> [lines]      print the tail of an allowed log
#   hostkeep-action backup-stream <day> [archive]   a whole backup day as tar, or one files/<archive>.tar.gz, on stdout
#   hostkeep-action export-bundle < config.json      migration archive (.tar.gz) on stdout: source code, config, restore.sh
#
# Never touches: sshd, network, firewall, certificate deletion. Reboot only through the "reboot" job.
set -uo pipefail
umask 027
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C HOME=/root PM2_HOME=/root/.pm2

JOBS=/var/lib/hostkeep/jobs
APP=/var/www/hostkeep
BACKUPS=/var/backups/hostkeep
SELF=/usr/local/sbin/hostkeep-action
SOURCE_FILE=/var/lib/hostkeep/source   # path of the git clone used for the install, written by install.sh
PREVIOUS_FILE=/var/lib/hostkeep/previous   # commit installed before the last self-update (for self-rollback)

# Settings from the install's .env (KEY=value). Read with grep, never sourced: nothing is executed.
env_get() {
  local v
  v=$(grep -m1 -E "^[[:space:]]*$1[[:space:]]*=" "$APP/.env" 2>/dev/null | cut -d= -f2- | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')
  v=${v#[\"\']}; v=${v%[\"\']}
  printf '%s' "${v:-${2:-}}"
}
PHPV=$(env_get HOSTKEEP_PHP_VERSION "$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null)")
detect_services() {
  local s out=()
  for s in apache2 nginx "php$PHPV-fpm" mariadb mysql fail2ban cron postfix; do
    [[ $s == mysql ]] && in_list mariadb "${out[@]}" && continue   # alias of mariadb on Debian
    systemctl cat "$s.service" >/dev/null 2>&1 && out+=("$s")
  done
  echo "${out[*]}"
}

die() { echo "Refusé : $*" >&2; exit 2; }
in_list() { local x=$1; shift; local i; for i in "$@"; do [[ $i == "$x" ]] && return 0; done; return 1; }
# Same, with the allowed values given as one space/newline separated string (service, PM2 and jail names).
in_words() { local -a w; read -r -d '' -a w <<< "$2" || true; in_list "$1" "${w[@]}"; }
pm2_names() { pm2 jlist 2>/dev/null | python3 -c 'import json,sys; [print(p["name"]) for p in json.load(sys.stdin)]' 2>/dev/null; }
jails() { fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr ',' '\n' | tr -d ' \t'; }
valid_ip() { python3 -I -c 'import ipaddress,sys; ipaddress.ip_address(sys.argv[1])' "$1" 2>/dev/null; }
services() { local s; s=$(env_get HOSTKEEP_SERVICES); if [[ -n $s ]]; then echo "$s"; else detect_services; fi; }

validate() {
  local verb=${1:-}; shift || true
  case $verb in
    service)
      [[ $# -eq 2 ]] || die "arguments"
      in_list "$1" restart reload || die "action de service inconnue"
      in_words "$2" "$(services)" || die "service non autorisé"
      if [[ $1 == reload && $2 == cron ]]; then die "reload non supporté pour cron"; fi ;;
    pm2-restart)
      [[ $# -eq 1 && $1 =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "nom d'appli"
      in_words "$1" "$(pm2_names)" || die "appli PM2 inconnue" ;;
    site)   # site enable|disable apache|nginx <config file name>
      [[ $# -eq 3 ]] || die "arguments"
      in_list "$1" enable disable || die "action de site inconnue"
      in_list "$2" apache nginx || die "serveur web inconnu"
      [[ $3 =~ ^[A-Za-z0-9._-]{1,100}$ && $3 != .* ]] || die "nom de vhost"
      [[ $3 == hostkeep* ]] && die "le vhost du tableau de bord est protégé"
      if [[ $2 == apache ]]; then [[ -f /etc/apache2/sites-available/$3.conf ]] || die "vhost inconnu"
      else [[ -f /etc/nginx/sites-available/$3 && ! -L /etc/nginx/sites-available/$3 && -d /etc/nginx/sites-enabled ]] || die "site Nginx inconnu"; fi
      return 0 ;;
    certbot)
      [[ $# -eq 1 ]] && in_list "$1" dry-run renew || die "action certbot" ;;
    web-domain)
      [[ $# -eq 1 && ${#1} -le 253 && $1 =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]] || die "nom de domaine invalide" ;;
    apt-clean|journal-vacuum|collect-now|backup-now|security-scan|apt-update|apt-upgrade|self-update|self-rollback|reboot|offsite-test|offsite-now)
      [[ $# -eq 0 ]] || die "arguments" ;;
    backup-restore)
      [[ $# -eq 2 && $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && $2 =~ ^[A-Za-z0-9_-]{1,64}$ ]] || die "arguments"
      [[ $2 == mysql ]] && die "la base système mysql ne se restaure pas d'ici"
      [[ -f $BACKUPS/$1/$2.sql.gz ]] || die "sauvegarde introuvable"
      mysql -N -e "SHOW DATABASES" | grep -qx -- "$2" || die "base inconnue" ;;
    f2b-unban)
      [[ $# -eq 2 && $1 =~ ^[a-z0-9_-]{1,40}$ ]] || die "arguments"
      in_words "$1" "$(jails)" || die "jail inconnue"
      valid_ip "$2" || die "adresse IP invalide" ;;
    *) die "action inconnue" ;;
  esac
}

# Git clone the panel was installed from: must be a root-owned checkout with install.sh.
source_dir() {
  local d
  d=$(head -n1 "$SOURCE_FILE" 2>/dev/null) || { echo "Pas de dépôt source enregistré : réinstalle depuis un clone git (sudo ./install.sh app)."; return 1; }
  [[ $d == /* && -d $d/.git && -f $d/install.sh ]] || { echo "Dépôt source introuvable : $d"; return 1; }
  [[ $(stat -c %u "$d") == 0 && $(stat -c %u "$d/install.sh") == 0 ]] || { echo "Le dépôt $d doit appartenir à root."; return 1; }
  echo "$d"
}

configtest() { echo "# apache2ctl configtest"; apache2ctl configtest 2>&1 | grep -v AH00558; return "${PIPESTATUS[0]}"; }

run() {
  local verb=$1; shift
  case $verb in
    service)
      if [[ $2 == apache2 ]]; then configtest || { echo "configtest en échec : rien n'a été fait."; return 1; }; fi
      if [[ $2 == nginx ]]; then echo "# nginx -t"; nginx -t 2>&1 || { echo "nginx -t en échec : rien n'a été fait."; return 1; }; fi
      echo "# systemctl $1 $2"
      systemctl "$1" "$2" || return 1
      sleep 1; systemctl --no-pager --lines=0 status "$2" | head -6 ;;
    pm2-restart)
      echo "# pm2 restart $1"; pm2 restart "$1" && pm2 list ;;
    site)
      if [[ $2 == apache ]]; then
        if [[ $1 == enable ]]; then
          a2ensite "$3" || return 1
          if ! configtest; then echo "configtest en échec : retour arrière."; a2dissite "$3"; return 1; fi
        else
          a2dissite "$3" || return 1
          if ! configtest; then echo "configtest en échec : retour arrière."; a2ensite "$3"; return 1; fi
        fi
        echo "# systemctl reload apache2"; systemctl reload apache2 && echo "Apache rechargé."
      else
        local link=/etc/nginx/sites-enabled/$3 f prev=()
        if [[ $1 == enable ]]; then
          echo "# ln -s ../sites-available/$3 $link"; ln -sfn "/etc/nginx/sites-available/$3" "$link" || return 1
          if ! { echo "# nginx -t"; nginx -t 2>&1; }; then echo "nginx -t en échec : retour arrière."; rm -f "$link"; return 1; fi
        else
          # every enabled entry that points to this file (it may have another name in sites-enabled)
          for f in /etc/nginx/sites-enabled/*; do [[ $(realpath -- "$f") == "/etc/nginx/sites-available/$3" ]] && prev+=("$f"); done
          ((${#prev[@]})) || { echo "Ce site n'est pas activé."; return 1; }
          echo "# rm ${prev[*]}"; rm -f -- "${prev[@]}"
          if ! { echo "# nginx -t"; nginx -t 2>&1; }; then echo "nginx -t en échec : retour arrière."; for f in "${prev[@]}"; do ln -sfn "/etc/nginx/sites-available/$3" "$f"; done; return 1; fi
        fi
        echo "# systemctl reload nginx"; systemctl reload nginx && echo "Nginx rechargé."
      fi ;;
    certbot)
      if [[ $1 == dry-run ]]; then certbot renew --dry-run --no-random-sleep-on-renew; else certbot renew --no-random-sleep-on-renew; fi ;;
    apt-clean)
      echo "Avant : $(du -sh /var/cache/apt | cut -f1)"; apt-get clean && echo "Après : $(du -sh /var/cache/apt | cut -f1)" ;;
    journal-vacuum)
      journalctl --vacuum-size=50M; journalctl --disk-usage ;;
    f2b-unban)
      fail2ban-client set "$1" unbanip "$2" ;;
    collect-now)
      php "$APP/bin/collect.php" all && echo "Collecte terminée." ;;
    backup-now)
      php "$APP/bin/collect.php" backup --force && echo "Sauvegarde terminée." ;;
    backup-restore)
      mkdir -p "$BACKUPS/pre-restore" && chgrp hostkeep "$BACKUPS/pre-restore" && chmod 750 "$BACKUPS/pre-restore"
      pre="$BACKUPS/pre-restore/$(date +%Y%m%d-%H%M%S)-$2.sql.gz"
      echo "# Copie de sécurité de l'état actuel de $2 -> $pre"
      bash -c 'set -o pipefail; mysqldump --single-transaction --quick --routines --triggers --events "$1" | gzip -6 > "$2"' _ "$2" "$pre" || { echo "Copie de sécurité impossible : restauration annulée."; rm -f "$pre"; return 1; }
      chgrp hostkeep "$pre"; chmod 640 "$pre"
      echo "# Restauration de $2 depuis la sauvegarde du $1"
      gunzip -c "$BACKUPS/$1/$2.sql.gz" | mysql "$2" || return 1
      php "$APP/bin/collect.php" backup-list >/dev/null 2>&1; echo "Restauration terminée." ;;
    security-scan)
      php "$APP/bin/collect.php" scan ;;
    offsite-test)
      php "$APP/bin/collect.php" offsite-test ;;
    offsite-now)
      php "$APP/bin/collect.php" offsite ;;
    apt-update)
      apt-get update && php "$APP/bin/collect.php" updates && apt list --upgradable 2>/dev/null ;;
    self-update)
      local src branch new
      src=$(source_dir) || { echo "$src"; return 1; }
      export GIT_TERMINAL_PROMPT=0
      branch=$(git -C "$src" rev-parse --abbrev-ref HEAD) || return 1
      git -C "$src" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1 || { echo "La branche $branch ne suit aucune branche distante."; return 1; }
      [[ -z $(git -C "$src" status --porcelain --untracked-files=no) ]] || { echo "Des fichiers ont été modifiés à la main dans $src : mise à jour annulée."; git -C "$src" status --short; return 1; }
      echo "# git fetch ($src, branche $branch)"
      timeout 60 git -C "$src" fetch --prune || return 1
      new=$(git -C "$src" log --format='%h %s' 'HEAD..@{u}')
      if [[ -z $new ]]; then echo "Hostkeep est déjà à jour ($(git -C "$src" log -1 --format='%h, %cd' --date=short))."; return 0; fi
      echo "Nouveautés :"; echo "$new" | sed 's/^/  /'
      git -C "$src" rev-parse HEAD > "$PREVIOUS_FILE.tmp" && mv "$PREVIOUS_FILE.tmp" "$PREVIOUS_FILE"
      echo "# git merge --ff-only"
      git -C "$src" merge --ff-only '@{u}' || { echo "Historique divergent : mise à jour annulée, rien n'a été modifié."; rm -f "$PREVIOUS_FILE"; return 1; }
      echo "# ./install.sh app"
      "$src/install.sh" app || return 1
      echo "Hostkeep mis à jour : $(git -C "$src" log -1 --format='%h %s'). Recharge la page." ;;
    self-rollback)
      local src prev
      src=$(source_dir) || { echo "$src"; return 1; }
      prev=$(head -n1 "$PREVIOUS_FILE" 2>/dev/null)
      [[ $prev =~ ^[0-9a-f]{40}$ ]] || { echo "Aucune version précédente enregistrée (elle l'est à chaque mise à jour depuis le panel)."; return 1; }
      git -C "$src" merge-base --is-ancestor "$prev" HEAD || { echo "La version $prev n'est pas un ancêtre de la version installée : retour arrière refusé."; return 1; }
      [[ -z $(git -C "$src" status --porcelain --untracked-files=no) ]] || { echo "Des fichiers ont été modifiés à la main dans $src : retour arrière annulé."; return 1; }
      echo "Version installée : $(git -C "$src" log -1 --format='%h %s')"
      echo "Retour à :          $(git -C "$src" log -1 --format='%h %s' "$prev")"
      echo "# git reset --hard ${prev:0:7}"
      git -C "$src" reset --hard "$prev" || return 1
      rm -f "$PREVIOUS_FILE"
      echo "# ./install.sh app"
      "$src/install.sh" app || return 1
      echo "Retour arrière terminé. Les nouveautés réapparaissent comme mises à jour disponibles. Recharge la page." ;;
    web-domain)
      local src
      src=$(source_dir) || { echo "$src"; return 1; }
      echo "# ./install.sh web --domain $1 --yes"
      echo "Ancien domaine : $(env_get HOSTKEEP_DOMAIN '(aucun)')"
      "$src/install.sh" web --domain "$1" --yes || { echo "Échec : la configuration précédente a été remise en place."; return 1; }
      echo "Panel désormais servi sur $1. Ouvre la nouvelle adresse (l'ancienne ne répond plus)." ;;
    reboot)
      local cur latest first
      cur=$(uname -r)
      # newest installed kernel of the same flavour (amd64, cloud-amd64…)
      latest=$(ls /boot | sed -n 's/^vmlinuz-//p' | grep -E -- "^[0-9.]+-[0-9]+-${cur#*-*-}\$" | sort -V | tail -n1)
      echo "Noyau actuel         : $cur"
      echo "Noyau le plus récent : ${latest:-?}"
      if [[ -n $latest && -f /boot/grub/grub.cfg ]] && command -v update-grub >/dev/null; then
        first=$(sed -n 's/^[[:space:]]*linux[[:space:]]\+[^[:space:]]*vmlinuz-\([^[:space:]]*\).*/\1/p' /boot/grub/grub.cfg | head -n1)
        if [[ $first != "$latest" ]]; then
          echo "# update-grub (premier choix actuel du menu : ${first:-?})"
          update-grub 2>&1 || { echo "update-grub en échec : redémarrage annulé."; return 1; }
        fi
      fi
      sync
      # Delayed so this job can finish and report its result before the machine goes down.
      echo "# systemctl reboot (dans 10 s)"
      systemd-run --quiet --collect --on-active=10 --unit="hostkeep-reboot-$(date +%s)" "$(command -v systemctl)" reboot || return 1
      echo "Redémarrage programmé : le serveur et le panel seront indisponibles 1 à 2 minutes. Recharge la page ensuite." ;;
    apt-upgrade)
      export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=l
      apt-get update || return 1
      apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold upgrade || return 1
      php "$APP/bin/collect.php" updates
      if [[ -f /run/reboot-required ]]; then echo "Un redémarrage du serveur est conseillé (Sécurité › Audit › Redémarrer le serveur)."; fi
      echo "Mises à jour installées." ;;
  esac
}

# Read-only file access, limited to these trees (after resolving symlinks and "..").
# HOSTKEEP_FILE_ROOTS in .env; only the folders that exist are kept.
FS_ROOTS=""
for r in $(env_get HOSTKEEP_FILE_ROOTS "/var/www /etc/apache2 /etc/nginx /etc/php /etc/mysql /etc/cron.d /etc/fail2ban /etc/letsencrypt/renewal /etc/logrotate.d /var/log"); do
  [[ $r == /* && -d $r ]] && FS_ROOTS+="$(realpath -e -- "$r") "
done
fs_path() {
  local p r
  [[ ${1:-} == /* && ${#1} -lt 4096 ]] || { echo "Refusé : chemin" >&2; return 2; }
  p=$(realpath -e -- "$1" 2>/dev/null) || { echo "Refusé : chemin introuvable" >&2; return 2; }
  for r in $FS_ROOTS; do
    if [[ $p == "$r" || $p == "$r/"* ]]; then echo "$p"; return 0; fi
  done
  echo "Refusé : hors des dossiers autorisés" >&2; return 2
}

cmd=${1:-}; shift || true
case $cmd in
  job)
    validate "$@"
    id="$(date +%s)-$$"
    log="$JOBS/$id.log"
    : > "$log" && chgrp hostkeep "$log" && chmod 640 "$log" || die "impossible de créer le journal de la tâche"
    # Transient unit: the job lives outside PHP-FPM's cgroup, so restarting php-fpm does not kill it.
    systemd-run --quiet --collect --unit="hostkeep-job-$id" -p StandardOutput="append:$log" -p StandardError=inherit \
      "$SELF" _run "$id" "$@" >/dev/null || die "systemd-run a échoué"
    echo "$id" ;;
  _run)
    id=${1:-}; shift || true
    [[ $id =~ ^[0-9]+-[0-9]+$ ]] || die "id"
    validate "$@"
    echo "### $(date '+%F %T') — $*"
    run "$@"; rc=$?
    echo "### Terminé (code $rc)"
    echo "$rc" > "$JOBS/$id.rc.tmp" && chgrp hostkeep "$JOBS/$id.rc.tmp" && chmod 640 "$JOBS/$id.rc.tmp" && mv "$JOBS/$id.rc.tmp" "$JOBS/$id.rc" ;;
  log)
    key=${1:-}; n=${2:-200}
    [[ $n =~ ^[0-9]{1,4}$ ]] || die "nombre de lignes"
    case $key in
      journal-errors) journalctl -p err -n "$n" --no-pager -o short-iso ;;
      fail2ban) tail -n "$n" /var/log/fail2ban.log ;;
      hostkeep-auth) tail -n "$n" /var/log/hostkeep/auth.log 2>/dev/null || true ;;
      apache:*|nginx:*)
        f=${key#*:}; d=/var/log/apache2; [[ $key == nginx:* ]] && d=/var/log/nginx
        [[ $f =~ ^[A-Za-z0-9._-]+\.log$ && -f $d/$f && ! -L $d/$f ]] || die "journal inconnu"
        tail -n "$n" -- "$d/$f" ;;
      pm2:*)
        a=${key#pm2:}
        [[ $a =~ ^[A-Za-z0-9._-]{1,64}$ ]] && in_words "$a" "$(pm2_names)" || die "appli PM2 inconnue"
        pm2 logs "$a" --lines "$n" --nostream --raw 2>&1 ;;
      *) die "journal inconnu" ;;
    esac ;;
  export-bundle)
    # stdin: JSON written by the panel (app/src/migration.php): manifest, settings without secrets, encrypted accounts
    src=$(source_dir) || die "$src"
    tmp=$(mktemp -d) || die "mktemp"
    trap 'rm -rf "$tmp"' EXIT
    head -c 5000000 > "$tmp/in.json"
    name="hostkeep-migration-$(hostname -s)-$(date +%F)"
    mkdir -p "$tmp/$name/source" "$tmp/$name/config" && chmod 700 "$tmp/$name"
    git -C "$src" archive --format=tar HEAD | tar -x -C "$tmp/$name/source" || die "git archive"
    python3 -I - "$tmp/in.json" "$tmp/$name/config" "$(git -C "$src" rev-parse HEAD)" "$(git -C "$src" rev-parse --abbrev-ref HEAD)" \
      "$(git -C "$src" remote get-url origin 2>/dev/null)" <<'PY' || die "configuration illisible"
import json, os, sys
src, out, commit, branch, repo = sys.argv[1:6]
d = json.load(open(src))
m = d["manifest"]
m.update({"commit": commit, "branch": branch, "repo": repo})
def write(name, obj):
    with open(os.path.join(out, name), "w") as f:
        json.dump(obj, f, ensure_ascii=False, indent=2)
write("manifest.json", m)
write("settings.json", d.get("settings") or {})
if d.get("accounts"):
    write("accounts.json.enc", d["accounts"])
PY
    # .env without anything secret (the key of the encrypted settings is regenerated on the new server)
    grep -vE '^[[:space:]]*(HOSTKEEP_APP_KEY|[A-Z_]*(PASSWORD|SECRET|TOKEN|_KEY)[A-Z_]*)[[:space:]]*=' "$APP/.env" > "$tmp/$name/config/env.public" 2>/dev/null || true
    install -m 755 "$src/system/restore.sh" "$tmp/$name/restore.sh"
    install -m 644 "$src/docs/RESTORE.md" "$tmp/$name/RESTORE.md"
    tar -cz -C "$tmp" "$name" ;;
  fs-roots)
    printf '%s\n' $FS_ROOTS ;;
  backup-stream)
    day=${1:-}; item=${2:-}
    [[ $day =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && -d $BACKUPS/$day ]] || die "sauvegarde introuvable"
    if [[ -n $item ]]; then
      [[ $item =~ ^[a-z0-9]{1,20}$ && -f $BACKUPS/$day/files/$item.tar.gz ]] || die "archive introuvable"
      cat -- "$BACKUPS/$day/files/$item.tar.gz"
    else
      tar -c -C "$BACKUPS" "$day"
    fi ;;
  fs-list)
    p=$(fs_path "${1:-}") || exit 2
    [[ -d $p ]] || die "pas un dossier"
    python3 -I - "$p" <<'PY'
import grp, json, os, pwd, stat, sys
path = sys.argv[1]
def name(fn, i):
    try: return fn(i)[0]
    except KeyError: return str(i)
out = []
with os.scandir(path) as it:
    for e in it:
        try: st = e.stat(follow_symlinks=False)
        except OSError: continue
        kind = 'link' if stat.S_ISLNK(st.st_mode) else 'dir' if stat.S_ISDIR(st.st_mode) else 'file'
        out.append({'name': e.name, 'type': kind, 'size': st.st_size, 'mtime': int(st.st_mtime),
                    'mode': stat.filemode(st.st_mode), 'owner': name(pwd.getpwuid, st.st_uid), 'group': name(grp.getgrgid, st.st_gid)})
out.sort(key=lambda x: (x['type'] != 'dir', x['name'].lower()))
print(json.dumps({'path': path, 'entries': out[:3000], 'total': len(out)}))
PY
    ;;
  fs-read)
    p=$(fs_path "${1:-}") || exit 2
    max=${2:-524288}
    [[ -f $p ]] || die "pas un fichier"
    [[ $max =~ ^[0-9]{1,9}$ ]] && (( max <= 52428800 )) || die "taille"
    [[ $(basename -- "$p") =~ (privkey|\.key$|^id_(rsa|ed25519|ecdsa)) ]] && die "clé privée : lecture refusée"
    head -c "$max" -- "$p" ;;
  *) die "commande inconnue" ;;
esac
