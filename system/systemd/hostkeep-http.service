# Hostkeep behind a reverse proxy (Traefik, HAProxy, Nginx Proxy Manager…): a small dedicated
# Nginx instance that serves the panel in plain HTTP on HOSTKEEP_HTTP_LISTEN (default 127.0.0.1:8090).
# The system nginx.service is not used. Config: /etc/hostkeep/nginx-http.conf (generated by install.sh).
[Unit]
Description=Hostkeep : serveur HTTP local (derrière un reverse proxy)
After=network.target hostkeep.service
Wants=hostkeep.service

[Service]
Type=forking
PIDFile=/run/hostkeep-http.pid
ExecStartPre=/usr/sbin/nginx -t -q -c /etc/hostkeep/nginx-http.conf
ExecStart=/usr/sbin/nginx -c /etc/hostkeep/nginx-http.conf
ExecReload=/usr/sbin/nginx -c /etc/hostkeep/nginx-http.conf -s reload
ExecStop=-/sbin/start-stop-daemon --quiet --stop --retry QUIT/5 --pidfile /run/hostkeep-http.pid
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
