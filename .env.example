# ---------------------------------------------------------------------------
# Hostkeep : configuration de l'installation
#
# 1. Copie ce fichier :   cp .env.example .env
# 2. Remplis au minimum HOSTKEEP_DOMAIN.
# 3. Lance l'installation : l'installateur le copie dans /var/www/hostkeep/.env
#    (propriétaire root:hostkeep, droits 640 : illisible pour les autres comptes).
#
# Format : une ligne CLE=valeur. Les lignes qui commencent par # sont ignorées.
# Les valeurs vides prennent la valeur par défaut indiquée.
# Ne versionne jamais ton .env (il est déjà dans le .gitignore).
# ---------------------------------------------------------------------------

# Nom de domaine du panel (obligatoire). Crée d'abord un enregistrement DNS A/AAAA
# qui pointe vers ce serveur : Let's Encrypt en a besoin pour délivrer le certificat.
HOSTKEEP_DOMAIN=admin.example.com

# Adresse e-mail pour Let's Encrypt (alertes d'expiration du certificat).
HOSTKEEP_LETSENCRYPT_EMAIL=

# Identifiant de connexion. NE PAS remplir le mot de passe à la main :
# lance  sudo php /var/www/hostkeep/bin/set-password.php  qui écrit le hash ci-dessous.
HOSTKEEP_ADMIN_USER=admin
HOSTKEEP_PASSWORD_HASH=

# Déconnexion automatique après N secondes sans activité (défaut : 1800 = 30 min).
HOSTKEEP_SESSION_TIMEOUT=1800

# Version de PHP-FPM utilisée par le panel, ex. 8.3 ou 8.4.
# Vide = version de la commande « php » du serveur.
HOSTKEEP_PHP_VERSION=

# Services systemd affichés et redémarrables depuis le panel, séparés par des espaces.
# Vide = détection automatique parmi : apache2 nginx phpX.Y-fpm mariadb mysql fail2ban cron postfix.
# Exemple : HOSTKEEP_SERVICES="apache2 php8.4-fpm mariadb fail2ban cron"
HOSTKEEP_SERVICES=

# Dossiers consultables (lecture seule) dans l'explorateur de fichiers, séparés par des espaces.
# Les clés privées y restent toujours illisibles. Vide = valeur par défaut :
# /var/www /etc/apache2 /etc/nginx /etc/php /etc/mysql /etc/cron.d /etc/fail2ban /etc/letsencrypt/renewal /etc/logrotate.d /var/log
HOSTKEEP_FILE_ROOTS=
