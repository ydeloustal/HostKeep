# ---------------------------------------------------------------------------
# Hostkeep : configuration du serveur
#
# Tu n'as normalement PAS à éditer ce fichier : l'installateur le crée dans
# /var/www/hostkeep/.env (propriétaire root:hostkeep, droits 640) et le remplit
# avec tes réponses. Les réglages du panel lui-même (nom, SMTP, sauvegardes,
# sécurité, comptes) se font dans l'interface : Administration › Paramètres.
#
# Format : une ligne CLE=valeur. Les lignes qui commencent par # sont ignorées.
# Les valeurs vides prennent la valeur par défaut indiquée.
# Ne versionne jamais ton .env (il est déjà dans le .gitignore).
# ---------------------------------------------------------------------------

# Domaine du panel. Son enregistrement DNS A/AAAA doit pointer vers ce serveur.
# Pour le changer : sudo hostkeep web --domain nouveau.domaine.fr (ou depuis le panel, en Super Admin).
HOSTKEEP_DOMAIN=

# Adresse e-mail pour Let's Encrypt (alertes d'expiration du certificat).
HOSTKEEP_LETSENCRYPT_EMAIL=

# Serveur web qui publie le panel : apache, nginx, caddy, proxy (Traefik, HAProxy… devant) ou none.
# Écrit par « install.sh web ». Pour changer : sudo hostkeep web <mode>
HOSTKEEP_WEBSERVER=

# HTTPS avec Let's Encrypt (yes) ou HTTP seul (no, déconseillé).
HOSTKEEP_HTTPS=yes

# Mode « proxy » uniquement : adresse HTTP locale sur laquelle le panel écoute (défaut 127.0.0.1:8090).
HOSTKEEP_HTTP_LISTEN=

# Mode « proxy » uniquement : adresses IP ou réseaux du reverse proxy, séparés par des espaces. Seuls eux peuvent
# indiquer l'adresse du visiteur (X-Forwarded-For). Écrit par l'installateur (--trusted-proxy).
HOSTKEEP_TRUSTED_PROXIES=

# Clé de chiffrement des secrets stockés en base (mot de passe SMTP). Générée à l'installation.
# Ne la change pas : les secrets déjà enregistrés deviendraient illisibles.
HOSTKEEP_APP_KEY=

# Version de PHP-FPM utilisée par hostkeep.service, ex. 8.3 ou 8.4.
# Vide = version de la commande « php » du serveur.
HOSTKEEP_PHP_VERSION=

# Services systemd affichés et redémarrables depuis le panel, séparés par des espaces.
# Vide = détection automatique parmi : apache2 nginx phpX.Y-fpm mariadb mysql fail2ban cron postfix.
# Exemple : HOSTKEEP_SERVICES="apache2 php8.4-fpm mariadb fail2ban cron"
HOSTKEEP_SERVICES=

# Dossiers consultables (lecture seule) dans l'explorateur de fichiers, séparés par des espaces.
# Les clés privées y restent toujours illisibles. Vide = valeur par défaut :
# /var/www /etc/apache2 /etc/nginx /etc/php /etc/mysql /etc/cron.d /etc/fail2ban /etc/letsencrypt/renewal /etc/logrotate.d /var/log
HOSTKEEP_FILE_ROOTS=

# Hostkeep 1.x uniquement : compte unique, importé automatiquement comme Super Admin lors de la mise à jour.
# Les comptes se gèrent désormais dans Administration › Utilisateurs ou avec « sudo hostkeep users ».
HOSTKEEP_ADMIN_USER=
HOSTKEEP_PASSWORD_HASH=
