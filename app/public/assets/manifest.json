{
  "name": "Hostkeep",
  "short_name": "Hostkeep",
  "description": "Panel d'administration léger pour surveiller et piloter un VPS Linux.",
  "lang": "fr",
  "dir": "ltr",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f5f6f8",
  "theme_color": "#4338ca",
  "categories": ["utilities", "productivity", "developer"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "/assets/screenshots/mobile.png", "sizes": "375x760", "type": "image/png", "form_factor": "narrow", "label": "Accueil : état du serveur et alertes" },
    { "src": "/assets/screenshots/desktop.png", "sizes": "1440x900", "type": "image/png", "form_factor": "wide", "label": "Accueil sur ordinateur" }
  ],
  "shortcuts": [
    { "name": "Accueil", "url": "/#home", "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sauvegardes", "url": "/#data/backups", "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Audit de sécurité", "url": "/#security/audit", "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sites", "url": "/#sites/sites", "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
